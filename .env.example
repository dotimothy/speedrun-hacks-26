# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# A key pasted into a chat, a terminal transcript or a commit should be
# treated as burned and rotated -- it is cheaper than finding out later.

# Cloud inference is OFF unless this is 1. Every other engine runs on
# this machine, and the project's pitch says so.
DISPATCHIQ_ALLOW_CLOUD=0
OPENAI_API_KEY=
DISPATCHIQ_OPENAI_MODEL=gpt-4o-mini

# Jev / TypeSafe System-One. Needs `pip install system-one-adapter`,
# which also upgrades anyio, h11, idna, packaging and typing_extensions.
DISPATCHIQ_JEV_ENDPOINT=
DISPATCHIQ_JEV_API_KEY=
DISPATCHIQ_JEV_IS_LOCAL=0
