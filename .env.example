# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# A key pasted into a chat, a terminal transcript or a commit should be
# treated as burned and rotated -- it is cheaper than finding out later.
#
# Everything here is optional. With none of it set, the prototype runs
# entirely on this machine with the local models and no telephony.


# ---------------------------------------------------------------- telephony
# Dial provides the phone number and the audio. Without these the websocket
# refuses every connection, which is the intended state when no demo is
# running: a socket that cannot authenticate a caller should not take calls.
#
# The signing secrets are per mode and come from
#   GET https://api.getdial.ai/api/v1/self-hosted/secret?mode=audio
#   GET https://api.getdial.ai/api/v1/self-hosted/secret?mode=llm
# They must match what Dial holds, or every call is rejected at the handshake.
DIAL_API_KEY=
DIAL_NUMBER=
DIAL_SIGNING_SECRET=
DIAL_LLM_SIGNING_SECRET=

# Who may ring the number. Comma-separated; compared on the last ten digits,
# so "4086445538" and "+1 408 644 5538" are the same number.
#
# EMPTY MEANS ANYONE. That is a reasonable default for a local prototype and a
# poor one for a number live on the public telephone network, because Dial has
# no allowlist of its own and this is the only thing in front of it.
DISPATCHIQ_ALLOWED_CALLERS=

# How the call is paced. Worth turning while listening to a demo rather than
# after editing code: how often the agent may speak, and how much audio each
# transcription pass gets.
DIAL_OPENING_PHRASE=greeting_en
DIAL_DECIDE_EVERY_S=3.0
DIAL_MIN_CHUNK_S=1.8
DIAL_WHISPER_SIZE=small


# ----------------------------------------------------------------- decisions
# Which engine answers the typed questions: laya | rules | openai | jev.
DISPATCHIQ_DECISION_ENGINE=laya

# Cloud inference is OFF unless this is 1, and cannot be switched on by a
# request parameter. Every other engine runs on this machine, and the
# project's pitch says so; turning this on makes that claim false until the
# slide is changed too.
DISPATCHIQ_ALLOW_CLOUD=0

OPENAI_API_KEY=
DISPATCHIQ_OPENAI_MODEL=gpt-4o-mini

# Post-decision summary and one scenario-specific follow-up. Requires
# DISPATCHIQ_ALLOW_CLOUD=1 and OPENAI_API_KEY. On live audio calls the question
# is spoken through Piper automatically and recorded in the operator transcript.
DISPATCHIQ_ASSISTANT_ENABLED=1
DISPATCHIQ_ASSISTANT_MODEL=gpt-6-luna
DISPATCHIQ_ASSISTANT_TIMEOUT=15

# Jev / TypeSafe System-One. Needs `pip install system-one-adapter`, which
# also upgrades anyio, h11, idna, packaging and typing_extensions -- the
# packages FastAPI and uvicorn sit on. Check that before installing.
# DISPATCHIQ_JEV_IS_LOCAL=1 only if the endpoint is self-hosted; it decides
# what /api/health reports about where inference happens.
DISPATCHIQ_JEV_ENDPOINT=
DISPATCHIQ_JEV_API_KEY=
DISPATCHIQ_JEV_IS_LOCAL=0


# ------------------------------------------------------------------- models
# DISPATCHIQ_WHISPER_SIZE=small
# DISPATCHIQ_LAYA_MODEL=multilingual
# DISPATCHIQ_LAYA_DEVICE=            # blank autodetects: cuda, then mps, then cpu


# --------------------------------------------------------------- thresholds
# Where the system stops guessing and reports unknown. Changing these changes
# what every score in the UI means.
# DISPATCHIQ_MIN_CHOICE=0.55
# DISPATCHIQ_NOUL_HIGH=0.70
# DISPATCHIQ_NOUL_LOW=0.30
# DISPATCHIQ_UNCORROBORATED_CAP=0.35


# -------------------------------------------------------------------- other
# DISPATCHIQ_MOCK=1                  # serve committed fixtures, load no models
# DISPATCHIQ_TTS_SPEED=0.7           # Piper length scale; lower is faster
# DISPATCHIQ_API=http://127.0.0.1:8000   # where smoke.py and bench.py look
# Dedicated OpenAI Decisions API (distinct from the generative openai engine).
# DISPATCHIQ_DECISION_ENGINE=openai_decisions
# DISPATCHIQ_ALLOW_CLOUD=1
DISPATCHIQ_DECISIONS_MODEL=gpt-6-luna
